---
import HoverArrow from "../components/HoverArrow.astro";
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { site, nav, footerNav, services, industries } from "../data/site";

interface Props { title?: string; description?: string; current: string }
const { title, description = site.description, current } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Complete Technology Solutions for Your Business`;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;

type MenuItem = { label: string; href: string; icon: string; sep?: boolean };
const menus: Record<string, MenuItem[]> = {
  "services/": services.map((s) => ({ label: s.title, href: `services/${s.id}/`, icon: s.icon })),
  "industries/": industries.map((i) => ({ label: i.title, href: `industries/${i.id}/`, icon: i.icon })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={base} aria-label={`${site.name} home`}><Logo /></a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
        <label for="nav-toggle" class="nav-button" aria-hidden="true"><Icon name="menu" size={26} /></label>
        <nav aria-label="Main">
          {nav.map((n) => menus[n.href] ? (
            <div class="has-menu">
              <a href={`${base}${n.href}`} aria-current={n.href === current ? "page" : undefined}>{n.label}<svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5"/></svg></a>
              <button class="sub-toggle" type="button" aria-expanded="false" aria-label={`Show ${n.label} pages`}><svg class="chev" width="16" height="16" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5"/></svg></button>
              <ul class="submenu">
                {menus[n.href].map((m) => (
                  <li class:list={{ "submenu-sep": m.sep }}><a href={`${base}${m.href}`} aria-current={path === `${base}${m.href}` ? "page" : undefined}><Icon name={m.icon} size={20} />{m.label}</a></li>
                ))}
              </ul>
            </div>
          ) : (
            <a href={`${base}${n.href}`} aria-current={n.href === current ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="btn btn-primary nav-cta" href={`${base}contact/`}>Let's Talk <svg class="hover-arrow" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path class="ha-line" d="M0 5h7" /><path class="ha-tip" d="M1 1l4 4-4 4" /></svg></a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>
    <script>
      // Phone menu: the arrow beside Services and Industries shows or hides their pages.
      document.querySelectorAll<HTMLButtonElement>(".sub-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const open = btn.parentElement!.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(open));
        });
      });
    </script>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div>
          <a href={base} aria-label={`${site.name} home`}><Logo light height={54} /></a>
          <p class="foot-about">Complete technology solutions for your business.</p>
        </div>
        <div>
          <h2>Company</h2>
          <ul>{footerNav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h2>Services</h2>
          <ul>{services.map((s) => <li><a href={`${base}services/${s.id}/`}>{s.title}</a></li>)}</ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            <li>{site.serviceArea}</li>
          </ul>
        </div>
      </div>
      <div class="wrap legal">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</div>
      <svg class="foot-wave" viewBox="0 0 600 170" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 170C330 164 500 112 600 24V58C500 132 330 170 70 170Z" fill="#8C1235" />
        <path d="M150 170C390 166 515 134 600 74V124C525 154 390 170 300 170Z" fill="#5BB3EF" />
      </svg>
    </footer>
  </body>
</html>
