---
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { site, nav, services, phoneHref } from "../data/site";

interface Props { title?: string; description?: string; current: string }
const { title, description = site.description, current } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Complete Technology Solutions for Your Business`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={base} aria-label={`${site.name} home`}><Logo /></a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
        <label for="nav-toggle" class="nav-button" aria-hidden="true"><Icon name="menu" size={26} /></label>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={`${base}${n.href}`} aria-current={n.href === current ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="btn btn-primary nav-cta" href={`${base}contact/`}>Get in Touch <Icon name="arrow" size={16} /></a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div>
          <a href={base} aria-label={`${site.name} home`}><Logo light height={44} /></a>
          <p class="foot-about">Complete technology solutions for your business.</p>
        </div>
        <div>
          <h2>Company</h2>
          <ul>{nav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h2>Services</h2>
          <ul>{services.map((s) => <li><a href={`${base}services/#${s.id}`}>{s.title}</a></li>)}</ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul>
            <li><a href={phoneHref}>{site.phone}</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            <li>{site.location}</li>
            <li>{site.serviceArea}</li>
          </ul>
        </div>
      </div>
      <div class="wrap legal">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</div>
      <svg class="foot-wave" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 118C220 112 430 80 600 14" fill="none" stroke="#6F263D" stroke-width="12" vector-effect="non-scaling-stroke" />
        <path d="M140 120C320 114 480 92 600 46" fill="none" stroke="#6BACE4" stroke-width="7" vector-effect="non-scaling-stroke" />
      </svg>
    </footer>
  </body>
</html>
