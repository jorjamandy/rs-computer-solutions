---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import HomeHero from "../components/HomeHero.astro";
import IndustriesReel from "../components/IndustriesReel.astro";
import Cta from "../components/Cta.astro";
import { services, beyond } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<Base current="">
  <HomeHero />

  <section class="section section-flush wwd" data-reveal>
    <div class="wwd-wave" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head wwd-head">
        <p class="eyebrow">What We Do</p>
        <h2>Complete Technology Solutions for <span class="hl">Your Business.</span></h2>
        <p>From IT infrastructure and networking to security systems, business communications, and ongoing technical support, RS Computer Solutions keeps your business connected, secure, and running smoothly.</p>
      </div>
      <div class="wwd-cards">
        {services.map((s, i) => (
          <a class="wwd-card" href={`${base}services/${s.id}/`} style={`--i:${i}`}>
            <span class="wwd-icon"><Icon name={s.icon} size={28} /></span>
            <h3>{s.title}</h3>
            <p>{s.card}</p>
            <span class="wwd-more">Learn more <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IndustriesReel />

  <section class="section tint beyond" data-reveal>
    <div class="beyond-glow" aria-hidden="true"></div>
    <div class="wrap beyond-grid">
      <div class="beyond-copy rv" style="--i:0">
        <p class="eyebrow">Beyond Traditional IT Support</p>
        <h2>One Company. <span class="hl">Complete Technology Support.</span></h2>
        <p class="muted">Your business relies on more than computers. From the network behind your operations to the cameras protecting your property and the phones connecting your customers, RS Computer Solutions brings everything together.</p>
        <ul class="beyond-tags" aria-label="What we handle">
          <li>Networks</li><li>Security Cameras</li><li>Phone Systems</li><li>Software</li><li>Ongoing Support</li>
        </ul>
        <a class="btn btn-primary" href={`${base}contact/`}>Talk to Our Team <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="beyond-list">
        {beyond.map((d, i) => (
          <li class="beyond-item rv" style={`--i:${i + 1}`}>
            <span class="beyond-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="beyond-icon"><Icon name={d.icon} size={26} /></span>
            <div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <script>
    // Fade sections in once as they scroll into view (skipped for reduced motion).
    const els = document.querySelectorAll("[data-reveal]");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
      }), { threshold: 0, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer doesn't fire.
      setTimeout(() => els.forEach((el) => el.classList.add("is-in")), 4000);
    }
  </script>

  <Cta title="Let's Keep Your Business Running Smoothly." text="Start with a free consultation." />
</Base>
