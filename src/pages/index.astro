---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Contact from "../components/Contact.astro";
import { site, services, pillars, industries, projects, steps, phoneHref } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.legalName} · {site.location}</p>
      <h1>IT support, security cameras, and phone systems for <span class="hl">Pennsylvania businesses.</span></h1>
      <p class="lede">
        We install and support the full technology setup for dental offices, law
        firms, restaurants, and parking facilities: servers, networks, cameras,
        phones, and the software you run every day. One company does all of it.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={phoneHref}>Call {site.phone}</a>
        <a class="btn btn-outline" href="#services">View services</a>
      </div>
    </div>
    <div class="wrap pillars">
      {pillars.map((p) => (
        <a class="pillar" href={`${base}services/${p.href}/`}>
          <span class="icon"><Icon name={p.icon} size={24} /></span>
          <h2>{p.title}</h2>
          <ul>
            {p.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section id="services" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>What we install and support</h2>
      </div>
      <div class="rows">
        {services.map((s, i) => (
          <a class="row" href={`${base}services/${s.slug}/`}>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.title}</h3>
            <div class="row-body">
              <p>{s.short}</p>
              <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            <span class="go"><Icon name="arrow" size={20} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="industries" class="section alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2>What we set up, by type of business</h2>
      </div>
      <div class="industries">
        {industries.map((ind) => (
          <div class="industry">
            <div class="industry-head">
              <span class="icon"><Icon name={ind.icon} size={24} /></span>
              <div>
                <h3>{ind.title}</h3>
                <p>{ind.text}</p>
              </div>
            </div>
            <ul class="ticks">
              {ind.setups.map((x) => (
                <li><Icon name="check" size={16} />{x}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="note">
        We also work with medical offices, retail stores, warehouses, and other
        small businesses. <a href="#contact">Ask about yours.</a>
      </p>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Typical projects</p>
        <h2>The jobs we're called for most</h2>
      </div>
      <div class="projects">
        {projects.map((p) => (
          <div class="project">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="section band">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>From first call to ongoing support</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Contact />
</Base>
