---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import HomeHero from "../components/HomeHero.astro";
import IndustriesReel from "../components/IndustriesReel.astro";
import Cta from "../components/Cta.astro";
import { services, beyond } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<Base current="">
  <HomeHero />

  <section class="section section-flush wwd" data-reveal>
    <svg class="wwd-swoosh" viewBox="0 0 600 170" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 170C330 164 500 112 600 24V58C500 132 330 170 70 170Z" fill="#8C1235" />
      <path d="M150 170C390 166 515 134 600 74V124C525 154 390 170 300 170Z" fill="#9CCDF1" />
    </svg>
    <div class="wrap">
      <div class="section-head wwd-head">
        <p class="eyebrow">Our Services</p>
        <h2>Technology Problems? <span class="hl">Consider Them Handled.</span></h2>
        <p>From networks and security cameras to phone systems, software, and ongoing IT support, RS Computer Solutions provides practical, reliable solutions that keep your business running.</p>
      </div>
      <div class="wwd-cards">
        {services.map((s, i) => (
          <a class="wwd-card" href={`${base}services/${s.id}/`} style={`--i:${i}`}>
            <span class="wwd-icon"><Icon name={s.icon} size={50} /></span>
            <h3>{s.homeTitle ?? s.title}</h3>
            <p>{s.card}</p>
            <span class="wwd-more">Learn More <Icon name="arrow" size={17} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IndustriesReel />

  <section class="section tint diff" data-reveal>
    <div class="diff-glow" aria-hidden="true"></div>
    <div class="wrap diff-grid">
      <div class="diff-intro rv" style="--i:0">
        <p class="eyebrow">The RS Difference</p>
        <h2>Experienced People. <span class="hl">Dependable Solutions.</span></h2>
        <p>Technology is only as good as the people behind it. At RS Computer Solutions, we believe in doing the job right, understanding our customers' businesses, and being there when they need us.</p>
      </div>
      <ul class="diff-list">
        {beyond.map((d, i) => (
          <li class="diff-item rv" style={`--i:${i + 1}`}>
            <span class="diff-icon"><Icon name={d.icon} size={36} /></span>
            <div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script>
    // Fade sections in once as they scroll into view (skipped for reduced motion).
    const els = document.querySelectorAll("[data-reveal]");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
      }), { threshold: 0, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer doesn't fire.
      setTimeout(() => els.forEach((el) => el.classList.add("is-in")), 4000);
    }
  </script>

  <Cta title="Let's Keep Your Business Running Smoothly." text="Tell us what your business needs. We'll help you find the right solution." />
</Base>
