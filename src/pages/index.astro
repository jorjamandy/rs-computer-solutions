---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import Stats from "../components/Stats.astro";
import { site, services, why, vendors } from "../data/site";
const base = import.meta.env.BASE_URL;
const feats = [
  { icon: "shield", a: "Panasonic", b: "Authorized Dealer", href: "panasonic-solutions/" },
  { icon: "desktop", a: "Business IT", b: "& Network Support", href: "services/it-networking/" },
  { icon: "camera", a: "Security &", b: "Surveillance", href: "services/security-surveillance/" },
  { icon: "phone", a: "Business", b: "Communications", href: "services/business-communications/" },
];
---
<Base current="">
  <PageHero home eyebrow="RS Computer Solutions">
    <h1>Technology You Can Count On. <span class="hl">People You Can Trust.</span></h1>
    <p class="lede">Reliable IT, security, communications, and technology solutions for businesses that need things done right.</p>
    <div class="actions">
      <a class="btn btn-primary" href={`${base}contact/`}>Get in Touch <Icon name="arrow" size={18} /></a>
      <a class="btn btn-outline" href={`${base}services/`}>Our Services</a>
    </div>
    <ul class="feats">
      {feats.map((f) => (
        <li><a href={`${base}${f.href}`}><Icon name={f.icon} size={30} /><span>{f.a}<br />{f.b}</span></a></li>
      ))}
    </ul>
  </PageHero>

  <section class="section-sm">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What We Do</p>
        <h2>Complete Technology Solutions for <span class="hl">Your Business.</span></h2>
        <p>From IT infrastructure and networking to security systems, business communications, and ongoing technical support, RS Computer Solutions keeps your business connected, secure, and running smoothly.</p>
      </div>
      <div class="cards cards-5">
        {services.map((s) => (
          <a class="card card-center" href={`${base}services/${s.id}/`}>
            <span class="icon"><Icon name={s.icon} size={40} /></span>
            <h3>{s.title}</h3>
            <p>{s.card}</p>
            <span class="rule"></span>
          </a>
        ))}
      </div>
      <a class="banner" href={`${base}panasonic-solutions/`}>
        <span class="tile"><Icon name="shield" size={36} /></span>
        <div>
          <h2>{site.panasonicTitle}</h2>
          <p>New Panasonic business phone systems, plus service, repair, and ongoing support.</p>
        </div>
        <span class="banner-link">Learn more <Icon name="arrow" size={16} /></span>
      </a>
    </div>
  </section>

  <Stats />

  <section class="section">
    <div class="wrap onestop">
      <div>
        <p class="eyebrow">One-Stop Technology Partner</p>
        <h2>One Partner Instead of <span class="hl">Four Vendors.</span></h2>
        <p class="muted">
          Most businesses end up managing a separate company for every system,
          and when something breaks, each one points at the others. RS Computer
          Solutions handles all of it, so your technology is planned, installed,
          and supported as one system by people who know your business.
        </p>
        <a class="btn btn-primary" href={`${base}services/`}>See Everything We Handle <Icon name="arrow" size={18} /></a>
      </div>
      <div class="compare">
        <div class="compare-col">
          <h3>The usual way</h3>
          <ul>{vendors.map((v) => <li>{v}</li>)}</ul>
        </div>
        <div class="compare-arrow"><Icon name="arrow" size={28} /></div>
        <div class="compare-col compare-rs">
          <h3>With RS</h3>
          <p class="compare-big">One call.</p>
          <p>Networks, cameras, phones, and software from a single, accountable partner.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap why">
      <div>
        <h2>Why Choose <span class="hl">RS Computer Solutions?</span></h2>
        <p class="muted">We deliver practical technology solutions, personalized service, and dependable long-term support for businesses of all sizes.</p>
      </div>
      <div class="why-grid">
        {why.map((w) => (
          <div class="why-item">
            <span class="icon"><Icon name={w.icon} size={34} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta title="Let's Keep Your Business Running Smoothly." text="Start with a free consultation." />
</Base>
