---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import Stats from "../components/Stats.astro";
import { about } from "../data/site";
---
<Base current="about/" title="About Us" description="RS Computer Solutions provides reliable business technology solutions with a hands-on, service-focused approach.">
  <PageHero eyebrow="About Us">
    <h1>Practical Technology. <span class="hl">Personal Service.</span></h1>
    <p class="lede">RS Computer Solutions provides reliable business technology solutions with a hands-on approach, helping organizations stay connected, secure, and productive.</p>
  </PageHero>

  <section class="section-sm">
    <div class="wrap about-split">
      <div class="about-photo">
        <img src={`${import.meta.env.BASE_URL}images/services/about-philadelphia-skyline.jpg`} alt="Philadelphia skyline over the Schuylkill River at sunset" style="object-position: 60% center" loading="eager" />
      </div>
      <div class="about-copy">
      <h2>A Technology Partner You Can Count On.</h2>
      <p>
        Established in 2006, RS Computer Solutions supports more than 100
        businesses across Pennsylvania, New Jersey, and Delaware, from
        neighborhood pizza shops and dental practices to multi-location parking
        operations. From initial installation and setup to troubleshooting and
        ongoing support, the company takes a straightforward, service-focused
        approach to helping customers maintain their essential systems.
      </p>
      </div>
    </div>
    <div class="wrap cards cards-4 about-cards">
      {about.map((a) => (
        <div class="card card-center">
          <span class="icon"><Icon name={a.icon} size={36} /></span>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
          <span class="rule"></span>
        </div>
      ))}
    </div>
  </section>

  <Stats />

  <div class="cta-gap"></div>
  <Cta title="Let's Talk About Your Business Technology Needs." />
</Base>
