---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Contact from "../../components/Contact.astro";
import { site, services, phoneHref } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const base = import.meta.env.BASE_URL;
---
<Base title={service.title} description={service.short}>
  <section class="hero hero-sub">
    <div class="wrap">
      <p class="label"><a href={`${base}#services`}>Services</a> / {service.title}</p>
      <h1>{service.title}</h1>
      <p class="lede">{service.intro}</p>
      <ul class="tags">{service.tags.map((t) => <li>{t}</li>)}</ul>
      <div class="actions">
        <a class="btn btn-primary" href={phoneHref}>Call {site.phone}</a>
        <a class="btn btn-ghost" href="#contact">Get a quote</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap detail">
      <div>
        <h2>What's included</h2>
        <ul class="ticks ticks-lg">
          {service.includes.map((item) => (
            <li><Icon name="check" size={18} />{item}</li>
          ))}
        </ul>
      </div>
      <aside class="aside">
        <h2>Best suited to</h2>
        <p>{service.goodFor}</p>
        <h2>Other services</h2>
        <ul class="others">
          {others.map((s) => (
            <li><a href={`${base}services/${s.slug}/`}><Icon name={s.icon} size={18} />{s.title}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <Contact topic={service.title} />
</Base>
