---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Contact from "../../components/Contact.astro";
import { site, services, phoneHref } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const base = import.meta.env.BASE_URL;
---
<Base title={service.title} description={service.short}>
  <section class="hero hero-sub">
    <div class="wrap">
      <p class="eyebrow"><a href={`${base}#services`}>Services</a> / {service.title}</p>
      <div class="sub-title">
        <span class="icon icon-lg"><Icon name={service.icon} size={34} /></span>
        <h1>{service.title}</h1>
      </div>
      <p class="lede">{service.intro}</p>
      <div class="actions">
        <a class="btn btn-accent" href={phoneHref}>Call {site.phone}</a>
        <a class="btn btn-ghost" href="#contact">Request a visit <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap detail">
      <div>
        <h2>What's included</h2>
        <ul class="checks">
          {service.includes.map((item) => (
            <li><span class="ok"><Icon name="check" size={16} /></span>{item}</li>
          ))}
        </ul>
      </div>
      <aside class="aside">
        <h2>A good fit for</h2>
        <p>{service.goodFor}</p>
        <h2>Also from RS</h2>
        <ul class="others">
          {others.map((s) => (
            <li><a href={`${base}services/${s.slug}/`}><Icon name={s.icon} size={18} />{s.title}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <Contact topic={service.title} />
</Base>
