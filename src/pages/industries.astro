---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { industries } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<Base current="industries/" title="Industries We Serve" description="Technology solutions for dental and healthcare practices, professional offices, retail and restaurants, and commercial properties.">
  <PageHero eyebrow="Industries">
    <h1>Technology Solutions for <span class="hl">Every Business.</span></h1>
    <p class="lede">Reliable, practical technology solutions tailored to the needs of your industry.</p>
  </PageHero>

  <section class="section-sm">
    <div class="wrap">
      <div class="cards cards-2">
        {industries.map((ind) => (
          <a class="card ind-card" href={`${base}industries/${ind.id}/`}>
            <span class="tile"><Icon name={ind.icon} size={38} /></span>
            <div>
              <h2>{ind.title}</h2>
              <p>{ind.text}</p>
              <span class="inline-link">Learn more <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
      <a class="more" href={`${base}contact/`}>
        <span class="icon"><Icon name="grid" size={30} /></span>
        <h2>And More</h2>
        <p>Warehouses, automotive businesses, and other small to midsize organizations. Contact us to discuss your specific needs.</p>
        <Icon name="arrow" size={22} />
      </a>
    </div>
  </section>

  <Cta title="Let's Find the Right Solution for Your Business." />
</Base>
