---
import HoverArrow from "../components/HoverArrow.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { site, panasonic } from "../data/site";
---
<Base current="services/" title="Panasonic Phone Systems" description="New Panasonic business phone systems plus service, repair, programming, and ongoing support from RS Computer Solutions, an authorized dealer and technician.">
  <PageHero eyebrow={site.panasonicTitle}>
    <h1>Panasonic Phone Systems: <span class="hl">Sales, Service &amp; Support.</span></h1>
    <p class="lede">Whether you need a new Panasonic system or expert service for the one you already rely on, you get an authorized dealer and technician who knows these systems inside and out.</p>
  </PageHero>

  <section class="section-sm">
    <div class="wrap pana-feature">
      <div class="about-photo pana-photo">
        <img src={`${import.meta.env.BASE_URL}images/services/panasonic-phone.jpg`} alt="Business desk phone on an office desk" loading="eager" />
      </div>
      <div class="about-copy">
        <h2>Business Phones Your Team <span class="hl">Already Knows.</span></h2>
        <p>From a single front desk to a multi-office practice, we supply, install, and program Panasonic business phone systems, then stay on call to service and support them for years to come.</p>
        <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}contact/`}>Ask About a System <HoverArrow /></a>
      </div>
    </div>
    <div class="wrap">
      <div class="cards cards-3">
        {panasonic.map((p) => (
          <article class="card ind-card ind-card-stack">
            <span class="tile"><Icon name={p.icon} size={38} /></span>
            <div>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta title="Let's Talk." text="Tell us what your business needs. We'll help you find the right solution." />
</Base>
