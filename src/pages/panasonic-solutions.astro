---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { site, panasonic } from "../data/site";
---
<Base current="services/" title="Panasonic Service & Support" description="Service, repair, programming, and ongoing support for Panasonic business phone systems and PBX from RS Computer Solutions.">
  <PageHero eyebrow={site.panasonicTitle}>
    <h1>Panasonic Phone System <span class="hl">Service &amp; Support.</span></h1>
    <p class="lede">Expert service for the Panasonic business phone system you already rely on, from a technician who knows these systems inside and out.</p>
  </PageHero>

  <section class="section-sm">
    <div class="wrap">
      <div class="cards cards-3">
        {panasonic.map((p) => (
          <article class="card ind-card ind-card-stack">
            <span class="tile"><Icon name={p.icon} size={38} /></span>
            <div>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta title="Need Help With Your Panasonic System?" button="Contact RS Computer Solutions" />
</Base>
