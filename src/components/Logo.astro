---
// RS Computer Solutions logo, drawn as shapes so it stays sharp at any size.
// `light` is the white version for dark backgrounds.
interface Props { light?: boolean; height?: number }
const { light = false, height = 62 } = Astro.props;
const red = "#8C1235";
const blue = "#5BB3EF";
const r = light ? "#FFFFFF" : red;
const s = light ? "#FFFFFF" : blue;
const text = light ? "#FFFFFF" : "#0B1F3B";
const star = light ? "#0B1F3B" : "#FFFFFF";
---
<svg class="logo" height={height} viewBox="0 0 388 104" role="img" aria-label="RS Computer Solutions">
  <g transform="translate(25 0) skewX(-20)">
    <path fill={r} fill-rule="evenodd" d="M30 14H78Q97 14 97 31Q97 44 85 47.500L99 69H73L61.5 50H53V80H19L24 60Z M53 27V38H69.5Q75.5 38 75.5 32.5Q75.5 27 69.5 27Z" />
    <path fill={s} d="M168 14V29.500H125Q121 29.5 121 32.500Q121 35.5 125 35.500H150Q169 35.5 169 52.500Q169 69 150 69H102V53.500H146Q150 53.5 150 50.500Q150 47.5 146 47.500H121Q102 47.5 102 31Q102 14 121 14Z" />
  </g>
  <path fill={star} d="M42 50.500l2.4 6.3 6.7.3-5.2 4.2 1.8 6.5-5.7-3.7-5.7 3.7 1.8-6.5-5.2-4.2 6.7-.3z" />
  <path fill={red} d="M12 87C28 73 54 70 80 74.500S132 84 168 65C142 93 106 88 80 83.500S34 79 12 87Z" />
  <path fill={blue} d="M26 97C46 86 70 85.5 92 89S136 95 160 80C138 101 110 100 90 96.500S50 92 26 97Z" />
  <path d="M201 9 185 90" stroke={text} stroke-width="2.6" stroke-linecap="round" />
  <g transform="translate(30 0) skewX(-12)" font-family="'Manrope Variable', Arial, sans-serif" font-weight="800" font-size="27" fill={text} stroke={text} stroke-width="0.9" stroke-linejoin="round">
    <text x="192" y="44">COMPUTER</text>
    <text x="192" y="71">SOLUTIONS</text>
  </g>
</svg>
