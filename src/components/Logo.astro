---
// RS Computer Solutions logo. `light` is the white version for dark backgrounds.
interface Props { light?: boolean; height?: number }
const { light = false, height = 46 } = Astro.props;
const r = light ? "#FFFFFF" : "#6F263D";
const s = light ? "#FFFFFF" : "#6BACE4";
const text = light ? "#FFFFFF" : "#0B1F3B";
const star = light ? "#0B1F3B" : "#FFFFFF";
---
<svg class="logo" height={height} viewBox="0 0 262 64" role="img" aria-label="RS Computer Solutions">
  <g transform="skewX(-14)">
    <text x="18" y="42" font-family="'Manrope Variable', Arial, sans-serif" font-weight="800" font-size="50" letter-spacing="-3" fill={r}>R</text>
    <text x="50" y="42" font-family="'Manrope Variable', Arial, sans-serif" font-weight="800" font-size="50" letter-spacing="-3" fill={s}>S</text>
  </g>
  <path transform="translate(3.2 -2.5)" d="M14.5 30.800l1.3 3.6 3.8.1-3 2.3 1.1 3.7-3.2-2.2-3.2 2.2 1.1-3.7-3-2.3 3.8-.1z" fill={star} />
  <path d="M2 50c14-7 26-7 40-2s28 4 42-3l-.6 4.600c-14 7-27.4 8-41.4 3S16 49 1.4 55z" fill="#6F263D" />
  <path d="M5 58c13-5 24-4.5 37-.5s27 3 40-3.500l-.5 3.800c-13 6.5-26.5 7.2-39.5 3.200S18 57.5 4.5 62z" fill="#6BACE4" />
  <path d="M104 8 94 56" stroke={text} stroke-width="1.6" stroke-linecap="round" />
  <g transform="skewX(-10)" font-family="'Manrope Variable', Arial, sans-serif" font-weight="800" font-size="19" letter-spacing="0.2" fill={text}>
    <text x="118" y="29">COMPUTER</text>
    <text x="118" y="49">SOLUTIONS</text>
  </g>
</svg>
