---
import Wave from "./Wave.astro";
interface Props { home?: boolean; eyebrow?: string; fill?: string }
const { home = false, eyebrow, fill = "#FFFFFF" } = Astro.props;
---
<section class:list={["hero", { "hero-home": home }]}>
  <div class="wrap hero-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <slot />
  </div>
  <Wave fill={fill} />
</section>
