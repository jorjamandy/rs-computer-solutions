---
interface Props { title: string; text?: string; button?: string; light?: boolean }
const { title, text, button = "Get in Touch", light = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="cta-wrap">
  <div class="wrap">
    <div class:list={["cta", { "cta-light": light }]}>
      <div>
        <h2>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      <a class:list={["btn", light ? "btn-primary" : "btn-white"]} href={`${base}contact/`}>{button} <svg class="hover-arrow" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true"><path class="ha-line" d="M0 5h7" /><path class="ha-tip" d="M1 1l4 4-4 4" /></svg></a>
    </div>
  </div>
</section>
