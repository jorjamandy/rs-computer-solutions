---
import Icon from "./Icon.astro";
interface Props { title: string; text?: string; button?: string; light?: boolean }
const { title, text, button = "Get in Touch", light = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="cta-wrap">
  <div class="wrap">
    <div class:list={["cta", { "cta-light": light }]}>
      <div>
        <h2>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      <a class:list={["btn", light ? "btn-primary" : "btn-white"]} href={`${base}contact/`}>{button} <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>
