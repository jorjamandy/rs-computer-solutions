---
// Line drawing of one building: every system in it, cabled back to one place.
---
<figure class="blueprint">
  <figcaption>
    <span>Fig. 01</span>
    <span>One building. Every system. One technician.</span>
  </figcaption>
  <svg viewBox="0 0 560 500" role="img" aria-label="Floor plan of a business showing the server, phones, workstations, Wi-Fi, and security cameras all connected.">
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="rgba(245,245,240,.06)" stroke-width="1" />
      </pattern>
      <linearGradient id="cone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#B22222" stop-opacity=".55" />
        <stop offset="1" stop-color="#B22222" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="560" height="500" fill="url(#grid)" />

    <!-- camera view cones -->
    <g class="cones">
      <path d="M110 338 60 440h100z" fill="url(#cone)" />
      <path d="M512 338 400 450h150z" fill="url(#cone)" />
      <path d="M172 160 60 215v60z" fill="url(#cone)" opacity=".7" />
    </g>

    <!-- parking -->
    <g class="lot">
      <rect x="40" y="372" width="480" height="100" rx="2" />
      <path d="M100 400v72M160 400v72M220 400v72M280 400v72M340 400v72M400 400v72M460 400v72" />
      <text x="48" y="388">PARKING</text>
    </g>

    <!-- walls -->
    <g class="walls">
      <path d="M40 50h480v280H130M90 330H40V50" />
      <path d="M180 50v150M180 240v90M40 150h100M180 190h340M350 50v140" />
    </g>

    <!-- room names -->
    <g class="rooms">
      <text x="48" y="66">SERVER</text>
      <text x="92" y="212">RECEPTION</text>
      <text x="190" y="66">OPERATORY 1</text>
      <text x="360" y="66">OPERATORY 2</text>
      <text x="190" y="208">OFFICE</text>
    </g>

    <!-- cabling -->
    <g class="cables">
      <path d="M94 100H432V112" />
      <path d="M262 100v12" />
      <path d="M92 118H212V262H442" />
      <path d="M212 222H342" />
      <path d="M80 126V236" />
      <path d="M68 126V318H504" />
      <path d="M110 318v14" />
    </g>

    <!-- server rack -->
    <g class="dev">
      <rect x="60" y="78" width="34" height="48" rx="3" />
      <path class="ink" d="M67 90h20M67 102h20M67 114h20" />
      <circle class="led" cx="88" cy="84" r="2" />
    </g>

    <!-- workstations -->
    <g class="dev">
      <rect x="248" y="112" width="28" height="18" rx="2" />
      <rect x="418" y="112" width="28" height="18" rx="2" />
      <rect x="228" y="254" width="28" height="18" rx="2" />
      <rect x="328" y="254" width="28" height="18" rx="2" />
      <rect x="428" y="254" width="28" height="18" rx="2" />
      <path d="M256 134h12M426 134h12M236 276h12M336 276h12M436 276h12" class="stand" />
    </g>

    <!-- reception desk + phone -->
    <g class="dev">
      <path class="desk" d="M56 236h74v26H56z" />
      <rect x="72" y="241" width="18" height="14" rx="2" />
      <path class="ink" d="M76 246h10M76 250h10" />
    </g>

    <!-- wifi -->
    <g class="wifi">
      <circle cx="350" cy="222" r="4" />
      <path d="M338 214a17 17 0 0 1 24 0M331 207a27 27 0 0 1 38 0" />
    </g>

    <!-- cameras -->
    <g class="cam">
      <circle cx="110" cy="336" r="6" />
      <circle cx="510" cy="324" r="6" />
      <circle cx="172" cy="160" r="6" />
    </g>

    <!-- labels -->
    <g class="labels">
      <g><text x="102" y="88">01 SERVER + DOMAIN</text></g>
      <g><text x="102" y="138">06 BACKUP</text></g>
      <g><text x="90" y="278">02 PHONES</text></g>
      <g><text x="284" y="126">04 WORKSTATIONS</text></g>
      <g><text x="366" y="226">05 WI-FI</text></g>
      <g><text x="124" y="352">03 CAMERAS</text></g>
    </g>
  </svg>
</figure>

<style>
  .blueprint { margin: 0; border: 1px solid rgba(245,245,240,.18); border-radius: 10px; background: rgba(245,245,240,.03); overflow: hidden; }
  figcaption {
    display: flex; justify-content: space-between; gap: 12px; padding: 12px 16px;
    font: 500 0.7rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase;
    color: #aab2c0; border-bottom: 1px solid rgba(245,245,240,.14);
  }
  figcaption span:first-child { color: #ef7a7a; }
  svg { display: block; width: 100%; height: auto; }
  text { font: 500 8.5px var(--mono); letter-spacing: 0.06em; }
  .walls path { fill: none; stroke: #F5F5F0; stroke-width: 2; stroke-linecap: square; }
  .rooms text { fill: #6B7280; }
  .lot rect { fill: none; stroke: #6B7280; stroke-dasharray: 5 5; }
  .lot path { stroke: #6B7280; stroke-opacity: .6; }
  .lot text { fill: #6B7280; }
  .cables path { fill: none; stroke: #e04a4a; stroke-width: 1.5; stroke-dasharray: 3 5; animation: flow 1.6s linear infinite; }
  .dev rect { fill: #0B1F3B; stroke: #F5F5F0; stroke-width: 1.4; }
  .dev .desk { fill: none; stroke: #6B7280; stroke-width: 1.2; }
  .dev .ink, .dev .stand { stroke: #F5F5F0; stroke-width: 1.2; fill: none; }
  .led { fill: #5fe39a; animation: blink 2s ease-in-out infinite; }
  .wifi circle { fill: #F5F5F0; }
  .wifi path { fill: none; stroke: #F5F5F0; stroke-width: 1.3; stroke-linecap: round; animation: pulse 2.4s ease-in-out infinite; }
  .cam circle { fill: #B22222; stroke: #F5F5F0; stroke-width: 1.5; }
  .cones path { animation: sweep 5s ease-in-out infinite; }
  .labels text { fill: #F5F5F0; }
  .labels path { stroke: #6B7280; }
  @keyframes flow { to { stroke-dashoffset: -16; } }
  @keyframes blink { 50% { opacity: .25; } }
  @keyframes pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
  @keyframes sweep { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .cables path, .led, .wifi path, .cones path { animation: none; } }
</style>
