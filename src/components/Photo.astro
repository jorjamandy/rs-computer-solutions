---
// Shows public/images/<name>.jpg (or .webp/.png) when the file exists.
// Until then it shows an illustrated placeholder, so nothing looks broken.
import fs from "node:fs";
import Icon from "./Icon.astro";
interface Props { name: string; alt: string; icon?: string; class?: string }
const { name, alt, icon = "network", class: cls = "" } = Astro.props;
const ext = ["jpg", "webp", "png"].find((e) => fs.existsSync(`public/images/${name}.${e}`));
const base = import.meta.env.BASE_URL;
---
{ext ? (
  <img class={`photo ${cls}`} src={`${base}images/${name}.${ext}`} alt={alt} loading="lazy" />
) : (
  <div class={`photo photo-empty ${cls}`} role="img" aria-label={alt}>
    <Icon name={icon} size={72} />
  </div>
)}
