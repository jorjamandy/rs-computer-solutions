---
import Icon from "./Icon.astro";
import { promises } from "../data/site";
---
<section class="promises">
  <div class="wrap promises-grid">
    {promises.map((p) => (
      <div class="promise">
        <span class="promise-icon"><Icon name={p.icon} size={30} /></span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
      </div>
    ))}
  </div>
</section>
