---
// "Industries We Serve" photo reel on the Home page. Slim photo panels
// glide open when hovered, focused, or tapped. On phones they stack.
// Each panel has two text layers: a small label for the slim state and a
// full caption for the open state. The full caption has a fixed width, so
// its text never rewraps while the panel is resizing; the layers cross-fade.
import Icon from "./Icon.astro";
import { reel } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<section class="section">
  <div class="wrap reel-card">
    <div class="section-head">
      <p class="eyebrow">Industries We Serve</p>
      <h2>Your Business. <span class="hl">Our Expertise.</span></h2>
      <p>From dental practices and law firms to restaurants and commercial properties, RS Computer Solutions provides dependable technology solutions for businesses of all kinds.</p>
    </div>
    <ul class="reel" data-reel>
      {reel.map((r, i) => (
        <li class:list={["reel-item", { "is-open": i === 0 }]}>
          <a href={`${base}${r.href}`} class="reel-link" aria-label={`${r.title}: ${r.text}`}>
            <img src={`${base}images/industries/${r.image}.jpg`} alt="" loading="lazy" style={`object-position:${r.focus ?? "center"}`} />
            <span class="reel-mini" aria-hidden="true">
              <Icon name={r.icon} size={26} />
              <span class="reel-mini-title">{r.title}</span>
              <span class="reel-rule"></span>
            </span>
            <span class="reel-full" aria-hidden="true">
              <Icon name={r.icon} size={30} />
              <span class="reel-title">{r.title}</span>
              <span class="reel-text">{r.text}</span>
            </span>
            <span class="reel-go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-reel]").forEach((reel) => {
    const items = [...reel.querySelectorAll<HTMLElement>(".reel-item")];
    const open = (el: HTMLElement) => items.forEach((i) => i.classList.toggle("is-open", i === el));

    // Width the open panel will settle at, so its caption can be laid out at
    // that width from the start instead of rewrapping as the panel grows.
    const size = () => {
      const cs = getComputedStyle(reel);
      const grow = parseFloat(cs.getPropertyValue("--open-grow")) || 3.4;
      const gap = parseFloat(cs.columnGap) || 0;
      const w = (reel.clientWidth - gap * (items.length - 1)) * grow / (grow + items.length - 1);
      reel.style.setProperty("--open-w", `${Math.floor(w)}px`);
    };
    size();
    new ResizeObserver(size).observe(reel);

    items.forEach((item) => {
      // Short hover delay, so sweeping the mouse across the row glides to
      // where it stops instead of flicking open every panel on the way.
      let timer = 0;
      item.addEventListener("mouseenter", () => { timer = window.setTimeout(() => open(item), 140); });
      item.addEventListener("mouseleave", () => clearTimeout(timer));
      item.addEventListener("focusin", () => open(item));
      // On touch screens the first tap opens a panel; a second tap follows its link.
      item.querySelector("a")!.addEventListener("click", (e) => {
        if (!item.classList.contains("is-open")) { e.preventDefault(); open(item); }
      });
    });
  });
</script>
