---
// The signature maroon and powder-blue swoosh. `fill` is the color of the
// section below, so the wave cuts cleanly into whatever sits above it.
interface Props { fill?: string; class?: string }
const { fill = "#FFFFFF", class: cls = "" } = Astro.props;
---
<svg class={`wave ${cls}`} viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 160V138C320 172 800 150 1440 30V160Z" fill={fill} />
  <path d="M440 152C800 150 1130 104 1440 4V58C1130 132 830 160 440 152Z" fill="#8C1235" />
  <path d="M520 158C860 160 1160 128 1440 66V104C1160 148 880 166 520 158Z" fill="#5BB3EF" />
</svg>
